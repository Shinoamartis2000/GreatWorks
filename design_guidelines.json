{
  "brand_identity": {
    "name": "GreatWorks Foundation",
    "tagline": "Empowering Communities, Restoring Hope.",
    "archetype": "Organic & Earthy (Trust, Growth, Calm)",
    "tone": "Human, Urgent, Transparent, Hopeful",
    "theme_preference": "light"
  },
  "typography": {
    "font_family": {
      "headings": "Playfair Display, serif",
      "body": "Manrope, sans-serif",
      "mono": "JetBrains Mono, monospace"
    },
    "scale": {
      "h1": "text-5xl md:text-7xl font-bold tracking-tight leading-[1.1]",
      "h2": "text-4xl md:text-5xl font-semibold tracking-tight",
      "h3": "text-2xl md:text-3xl font-medium",
      "body_large": "text-lg md:text-xl leading-relaxed",
      "body_base": "text-base leading-relaxed text-muted-foreground",
      "caption": "text-sm font-medium tracking-widest uppercase text-muted-foreground"
    },
    "rules": [
      "Never use Inter for headings.",
      "Use Playfair Display for all H1-H3 headings to evoke a 'Storytelling' feel.",
      "Use Manrope for all body text and UI elements for high readability.",
      "Headings must be tight (tracking-tight).",
      "Captions must be wide (tracking-widest)."
    ]
  },
  "colors": {
    "palette": {
      "primary": {
        "DEFAULT": "#2F5233",
        "foreground": "#FFFFFF",
        "description": "Deep Forest Green - Represents growth, stability, and nature."
      },
      "secondary": {
        "DEFAULT": "#E07A5F",
        "foreground": "#FFFFFF",
        "description": "Terracotta - Represents earth, humanity, and urgent action."
      },
      "accent": {
        "DEFAULT": "#F2CC8F",
        "foreground": "#2F5233",
        "description": "Soft Gold/Wheat - Represents hope and warmth."
      },
      "background": {
        "DEFAULT": "#F4F1DE",
        "alt": "#E9E4D2",
        "description": "Bone/Eggshell - Organic alternative to harsh white."
      },
      "foreground": {
        "DEFAULT": "#3D405B",
        "muted": "#6B705C",
        "description": "Charcoal/Slate - Softer than pure black."
      },
      "destructive": {
        "DEFAULT": "#D62828",
        "foreground": "#FFFFFF"
      }
    },
    "gradients": {
      "hero_overlay": "linear-gradient(180deg, rgba(47,82,51,0.4) 0%, rgba(47,82,51,0.8) 100%)",
      "subtle_glow": "radial-gradient(circle at 50% 50%, rgba(242,204,143,0.15), transparent 70%)"
    },
    "rules": [
      "Avoid pure black (#000000). Use #3D405B.",
      "Avoid pure white (#FFFFFF) for main backgrounds. Use #F4F1DE.",
      "Use Primary Green for main actions (Donate).",
      "Use Secondary Terracotta for urgent alerts or secondary CTAs (Volunteer)."
    ]
  },
  "layout_strategies": {
    "container": "max-w-7xl mx-auto px-6 md:px-12",
    "spacing": {
      "section_padding": "py-20 md:py-32",
      "element_gap": "gap-8 md:gap-12"
    },
    "grids": {
      "bento_impact": "grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 auto-rows-[300px]",
      "feature_list": "grid grid-cols-1 md:grid-cols-2 gap-16 items-center"
    },
    "glassmorphism": {
      "header": "bg-[#F4F1DE]/80 backdrop-blur-md border-b border-[#2F5233]/10",
      "card": "bg-white/60 backdrop-blur-sm border border-white/40 shadow-sm hover:shadow-md transition-all duration-300"
    }
  },
  "components": {
    "buttons": {
      "primary": "rounded-full px-8 py-6 text-lg font-semibold shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300",
      "secondary": "rounded-full px-8 py-6 text-lg font-medium border-2 border-[#2F5233] text-[#2F5233] hover:bg-[#2F5233] hover:text-white transition-all duration-300",
      "ghost": "hover:bg-[#2F5233]/10 text-[#2F5233] font-medium"
    },
    "cards": {
      "impact_story": "group relative overflow-hidden rounded-2xl bg-white shadow-sm hover:shadow-xl transition-all duration-500",
      "donation_tier": "rounded-xl border-2 border-[#2F5233]/10 bg-white p-8 hover:border-[#2F5233] hover:scale-[1.02] transition-all duration-300"
    },
    "inputs": {
      "style": "rounded-lg border-[#2F5233]/20 bg-white/50 focus:border-[#2F5233] focus:ring-[#2F5233]/20 h-12"
    }
  },
  "motion": {
    "library": "framer-motion",
    "variants": {
      "fadeInUp": {
        "hidden": { "opacity": 0, "y": 40 },
        "visible": { "opacity": 1, "y": 0, "transition": { "duration": 0.8, "ease": [0.22, 1, 0.36, 1] } }
      },
      "staggerContainer": {
        "hidden": { "opacity": 0 },
        "visible": { "opacity": 1, "transition": { "staggerChildren": 0.1 } }
      },
      "scaleIn": {
        "hidden": { "opacity": 0, "scale": 0.9 },
        "visible": { "opacity": 1, "scale": 1, "transition": { "duration": 0.5 } }
      }
    },
    "rules": [
      "Use 'AnimatePresence' for page transitions.",
      "Use 'LayoutGroup' for smooth layout shifts.",
      "Scroll-triggered animations for all major sections (Impact, Stories)."
    ]
  },
