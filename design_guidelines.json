  "universal_guidelines": [
    "Do not use generic centered layouts. Use asymmetry.",
    "Do not use 'Inter' for headings. Use 'Playfair Display'.",
    "Do not use pure black or white. Use the defined palette.",
    "Always add 'data-testid' to interactive elements.",
    "Use 'sonner' for toasts.",
    "Use 'framer-motion' for all animations.",
    "Ensure all images have alt text for accessibility.",
    "Forms must skip CAPTCHA as per requirements."
  ]
